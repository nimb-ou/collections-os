# CollectOS Configuration
# Copy this to .env and customize as needed

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENV=development
PROJECT_NAME=CollectOS
DEPLOYMENT_TARGET=mac  # mac | office

# =============================================================================
# SCALE CONFIGURATION
# =============================================================================
# SMALL_MODE=1 uses 30k accounts for fast dev iteration
# SMALL_MODE=0 uses full 300k accounts (requires more memory and time)
SMALL_MODE=1
N_ACCOUNTS=30000  # overridden to 300000 if SMALL_MODE=0
HISTORY_MONTHS=24
SEED=42

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=collectos
POSTGRES_USER=collectos
POSTGRES_PASSWORD=collectos_dev_password_change_in_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Postgres resource limits (docker)
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_WORK_MEM=50MB

# =============================================================================
# METABASE (BI)
# =============================================================================
METABASE_PORT=3000
MB_DB_TYPE=postgres
MB_DB_DBNAME=${POSTGRES_DB}
MB_DB_PORT=${POSTGRES_PORT}
MB_DB_USER=${POSTGRES_USER}
MB_DB_PASS=${POSTGRES_PASSWORD}
MB_DB_HOST=postgres

# =============================================================================
# API
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change_this_to_a_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =============================================================================
# DAGSTER (Pipeline Execution)
# =============================================================================
DAGSTER_HOME=.dagster
DAGSTER_PORT=3001

# =============================================================================
# DBT
# =============================================================================
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# =============================================================================
# OLLAMA (Local LLM)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# =============================================================================
# VOICE BOT (STT/TTS)
# =============================================================================
# STT
WHISPER_MODEL=small  # tiny | base | small | medium (int8)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-default
TTS_SAMPLE_RATE=22050

# =============================================================================
# SYNTHETIC DATA GENERATION
# =============================================================================
# Product mix (should sum to ~100)
PRODUCT_MIX_HCV=22
PRODUCT_MIX_LCV=28
PRODUCT_MIX_TIPPER=15
PRODUCT_MIX_TRACTOR=18
PRODUCT_MIX_CE=17

# Behavioral archetype distribution (should sum to 100)
ARCHETYPE_PRIME=55
ARCHETYPE_SPORADIC=25
ARCHETYPE_STRESSED=12
ARCHETYPE_CHRONIC=6
ARCHETYPE_STRATEGIC=2

# Agent counts
N_FOS=1500
N_TELECALLERS=300
N_TL=120
N_ACM=15
N_RCM=5

# =============================================================================
# BUSINESS RULES
# =============================================================================
# Contact hours (24h format, enforced in queue builder)
CONTACT_HOUR_START=08
CONTACT_HOUR_END=19

# Campaign control group percentage (for uplift measurement)
CONTROL_GROUP_PCT=5

# Capacity limits
FOS_DAILY_CAPACITY_MIN=40
FOS_DAILY_CAPACITY_MAX=70
TC_DAILY_DIAL_CAPACITY=250
TC_DAILY_CONNECT_TARGET=60

# =============================================================================
# RETENTION & CLEANUP
# =============================================================================
# Data retention in months
RETENTION_MONTHS=13
# Days to keep logs
LOG_RETENTION_DAYS=90

# =============================================================================
# EXTERNAL INTEGRATIONS (Office deployment only)
# =============================================================================
# SMS Gateway
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Dialer
DIALER_INTEGRATION_TYPE=file  # file | api | freeswitch
DIALER_LIST_OUTDIR=
DIALER_DISPO_INDIR=

# SMTP (for reports)
SMTP_HOST=localhost
SMTP_PORT=1025  # mailpit for dev
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=collectos@example.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_BOT=true
ENABLE_FIELD_PWA=true
ENABLE_INTERVENTIONS_ENGINE=true
ENABLE_CONTROL_GROUPS=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text
